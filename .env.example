# LoopWise Environment Configuration Example
# Copy this file to .env and fill in the actual values for your environment

ENVIRONMENT=development

# Data Stores
# For local development (SQLite): sqlite+aiosqlite:///./loopwise.db
# For production (PostgreSQL): postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./loopwise.db
REDIS_URL=redis://localhost:6379/0

# ML & Storage
# ONNX image classification is the ONLY classification path. There is no demo
# or mock fallback: if these are wrong or the files are missing, /classify
# returns 503 and /health reports inference_engine as "unavailable".
#
# Both default to the approved V1 artefacts in the repository (resolved from
# the backend package location), so a local checkout needs no .env at all.
# Override them for deployments. Paths below are relative to backend/.
MODEL_PATH=../ml/models/loopwise-yolo26n-cls.onnx
CLASS_INDEX_MAP=../ml/models/loopwise-yolo26n-cls.class-index-map.json
MODEL_VERSION=yolo26n-cls-v1
# The shipped model already emits probabilities — never re-softmax it.
MODEL_OUTPUT=probabilities
# S3 bucket for consent-gated image storage (production only)
S3_BUCKET=
AWS_REGION=ap-south-1

# Security & Auth
# Generate a secure random key for production (min 32 chars)
SECRET_KEY=loopwise-development-secret-key-32-chars-minimum!
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS
# Comma-separated list of allowed origins for frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
