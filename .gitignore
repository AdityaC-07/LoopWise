# Env & secrets (never commit)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
alembic/versions/__pycache__/

# Node
node_modules/
dist/
dist-ssr/
*.local

# ML artefacts (large / local-only)
ml/.venv/
ml/data/
ml/runs/
ml/runs_*/
runs/
runs_*/
ml/models/
ml/models/*.onnx
ml/models/*.pt
ml/loopwise-v2-artifacts/

# Local database files (SQLite)
*.db
*.db-shm
*.db-wal
loopwise.db

# Model weights / exports (auto-downloaded checkpoints, e.g. yolo26n-cls.pt)
*.pt
*.onnx

# OS / editors
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
*.log
